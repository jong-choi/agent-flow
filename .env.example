# Copy to .env and fill secrets locally.
# GOOGLE_AI_API_KEY: Google AI; GOOGLE_SEARCH_API_KEY: Google Custom Search.
# AUTH_SECRET and TEST_PASSWORD must be non-empty random local values.
# DATABASE_URL password must match POSTGRES_PASSWORD.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GROQ_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
BRAVE_API_KEY=
SEARXNG_BASE_URL=
SEARXNG_API_KEY=
DATABASE_URL=postgresql://agentflow:CHANGE_ME@127.0.0.1:55432/agentflow_dev
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SECRET=
TEST_PASSWORD=
AUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
GOOGLE_AI_API_KEY=
OLLAMA_API_KEY=

# Production maintenance is opt-in (also requires the maintenance Compose profile).
AI_MAINTENANCE_ENABLED=false
